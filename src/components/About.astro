---
const features = [
  {
    title: "3 Years in Business",
    desc: "A proven track record of delivering reliable, high-quality services to our community.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`
  },
  {
    title: "5-Star Reviews",
    desc: "Highly recommended by our customers for being efficient, careful, and always polite.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.364 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.364-1.118L2.049 10.1c-.783-.57-.38-1.81.588-1.81h4.915a1 1 0 00.95-.69l1.519-4.674z" /></svg>`
  },
  {
    title: "Fully Insured",
    desc: "Complete peace of mind knowing your property and belongings are protected during any job.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`
  },
  {
    title: "We Do It All",
    desc: "A truly versatile service. From moving pianos and motorcycles to fixing leaks and clearing gardens.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`
  }
];
---

<section id="about" class="py-24 px-6 bg-white border-t border-gray-200 relative z-10">
  <div class="max-w-7xl mx-auto">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <div>
        <div class="relative inline-block mb-4">
          <span class="text-mammoth-green font-light tracking-widest uppercase text-2xl md:text-3xl block relative z-10 pb-2">
            Who We Are
          </span>
          <span class="absolute bottom-0 left-0 w-full h-[3px] bg-mammoth-green animate-slide-right origin-left"></span>
        </div>

        <h2 class="text-4xl md:text-5xl font-black uppercase text-gray-900 leading-tight mt-2 mb-8">
          The <span class="text-mammoth-green">OMOV</span> <br/> Difference
        </h2>

        <div class="space-y-6 text-gray-700 text-lg leading-relaxed">
          <p>
            If you are looking for a versatile, friendly, and reliable service, then look no further than <strong>One Man One Van</strong>. 
          </p>
          <p>
            Specializing in all aspects of property and garden maintenance, house moves, and waste clearance, we really can do it all. Whether we're carefully transporting a piano, replacing wet loft insulation, or safely disposing of hazardous waste, we handle every job with the utmost professionalism.
          </p>
          <p>
            We are fully insured, 5-star rated, and fully licensed by the Environment Agency. We pride ourselves on offering highly competitive pricing with absolutely no obligation quotes. 
          </p>
        </div>

        <div class="mt-10 inline-flex flex-col sm:flex-row items-center sm:items-stretch border-2 border-[#808080] rounded-sm overflow-hidden shadow-md">
          <div class="bg-[#808080] text-white px-6 py-4 flex items-center justify-center font-black uppercase tracking-widest text-sm">
            EA License No.
          </div>
          <div class="bg-gray-50 text-gray-900 px-6 py-4 font-mono text-xl font-bold flex items-center justify-center">
            CBDU407131
          </div>
        </div>
      </div>

      <div id="about-flip-container" class="perspective-1000 w-full cursor-pointer">
        <div id="about-flip-card" class="relative w-full transition-transform duration-1000 transform-style-3d shadow-xl rounded-sm">
          
          <div class="relative w-full backface-hidden bg-white">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {features.map(feature => (
                <div class="bg-[#808080] p-8 rounded-sm shadow-md border-2 border-transparent transition-all duration-300 flex flex-col justify-center">
                  <div class="text-mammoth-green mb-4">
                    <Fragment set:html={feature.icon} />
                  </div>
                  <h3 class="text-xl font-black text-white uppercase mb-3">{feature.title}</h3>
                  <p class="text-gray-200 text-sm leading-relaxed">
                    {feature.desc}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <div class="absolute inset-0 w-full h-full backface-hidden rotate-y-180 rounded-sm overflow-hidden border-4 border-mammoth-green">
            <img src="/images/inside-van.jpeg" alt="Clean and spacious van interior" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/90 via-charcoal/30 to-transparent"></div>
            
            <div class="absolute bottom-6 left-0 right-0 text-center flex flex-col items-center">
              <div class="bg-black/80 backdrop-blur-md px-6 py-3 rounded-full inline-flex items-center gap-3 border border-mammoth-green/50">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-mammoth-green" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span class="text-white font-black tracking-widest uppercase text-sm md:text-base">Clean & Spacious Vans</span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes slideRight {
    0% { transform: scaleX(0); }
    50% { transform: scaleX(1); }
    100% { transform: scaleX(0); }
  }
  .animate-slide-right {
    animation: slideRight 3.5s ease-in-out infinite;
  }

  /* 3D Flip Card CSS */
  .perspective-1000 {
    perspective: 1000px;
  }
  .transform-style-3d {
    transform-style: preserve-3d;
  }
  .backface-hidden {
    backface-visibility: hidden;
  }
  .rotate-y-180 {
    transform: rotateY(180deg);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const flipContainer = document.getElementById('about-flip-container');
    const flipCard = document.getElementById('about-flip-card');
    let isFlipped = false;
    let flipInterval;

    function toggleFlip() {
      isFlipped = !isFlipped;
      if (isFlipped) {
        flipCard.classList.add('rotate-y-180');
      } else {
        flipCard.classList.remove('rotate-y-180');
      }
    }

    function startAutoFlip() {
      // Flips every 3.5 seconds
      flipInterval = setInterval(toggleFlip, 3500);
    }

    function stopAutoFlip() {
      clearInterval(flipInterval);
    }

    if (flipContainer && flipCard) {
      // Start loop on load
      startAutoFlip();

      // On hover: Stop auto-flip and show the Van (back side)
      flipContainer.addEventListener('mouseenter', () => {
        stopAutoFlip();
        flipCard.classList.add('rotate-y-180');
        isFlipped = true;
      });

      // On mouse leave: Show the grid (front side) and restart loop
      flipContainer.addEventListener('mouseleave', () => {
        flipCard.classList.remove('rotate-y-180');
        isFlipped = false;
        startAutoFlip();
      });
    }
  });
</script>