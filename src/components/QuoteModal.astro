---
<div id="quote-modal" class="fixed inset-0 z-[100] hidden bg-black/80 backdrop-blur-sm opacity-0 transition-opacity duration-300 overflow-y-auto">
  
  <div class="min-h-screen flex items-center justify-center p-4 sm:p-6">
    
    <div class="bg-charcoal border-t-8 border-mammoth-green w-full max-w-3xl shadow-2xl relative flex flex-col transform scale-95 transition-transform duration-300 mx-auto rounded-sm" id="modal-content">
      
      <button id="close-quote-modal" class="absolute top-4 right-4 text-gray-400 hover:text-white bg-black/50 hover:bg-mammoth-green p-2 rounded-full transition-colors z-10 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>

      <div class="p-8 md:p-10">
        <h2 class="text-3xl font-black uppercase text-white mb-2">Request a <span class="text-mammoth-green">CSM</span> Quote</h2>
        <p class="text-gray-400 mb-8 font-medium">Fill out the details below, and it will be sent directly to Conor via WhatsApp for a fast response.</p>

        <form id="whatsapp-quote-form" class="space-y-6">

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Full Name *</label>
              <input type="text" id="wa-name" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors rounded-sm" placeholder="John Doe">
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Phone Number *</label>
              <input type="tel" id="wa-phone" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors rounded-sm" placeholder="07123 456789">
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Email Address (Optional)</label>
              <input type="email" id="wa-email" class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors rounded-sm" placeholder="john@example.com">
            </div>
          </div>

          <hr class="border-gray-700 my-4" />

          <div class="space-y-4">
            <div>
              <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Pickup / Primary Address *</label>
              <input type="text" id="wa-address1" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors rounded-sm" placeholder="House Name/Number and Street">
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Town / City *</label>
                <input type="text" id="wa-city" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors rounded-sm" placeholder="e.g. Selby">
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Postcode *</label>
                <input type="text" id="wa-postcode" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors uppercase rounded-sm" placeholder="YO8 4">
              </div>
            </div>
          </div>

          <hr class="border-gray-700 my-4" />

          <div class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Service Required *</label>
                <select id="wa-service" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors appearance-none cursor-pointer rounded-sm">
                  <option value="" disabled selected>Select a service...</option>
                  <option value="House & Office Moves">House & Office Moves</option>
                  <option value="Waste Disposal">Waste Disposal</option>
                  <option value="Property Clearances">Property Clearances</option>
                  <option value="Bike Transport">Bike Transport</option>
                  <option value="Store Pickups">Store Pickups</option>
                  <option value="Single Item Runs">Single Item Runs</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Timescale *</label>
                <select id="wa-timescale" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors appearance-none cursor-pointer rounded-sm">
                  <option value="" disabled selected>When do you need it done?</option>
                  <option value="ASAP">ASAP (Urgent)</option>
                  <option value="Within 3 Days">Within 3 Days</option>
                  <option value="Within 1 Week">Within 1 Week</option>
                  <option value="Flexible">Flexible</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Job Details & Drop-off Location *</label>
              <textarea id="wa-description" rows="4" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors resize-none rounded-sm" placeholder="Please describe the items to be moved/cleared, and the drop-off postcode if applicable..."></textarea>
              <p class="text-xs text-mammoth-green font-bold mt-2">Note: You can attach photos of the items once WhatsApp opens!</p>
            </div>
          </div>

          <button type="submit" class="w-full bg-[#25D366] hover:bg-[#128C7E] text-white flex items-center justify-center gap-3 font-black text-xl uppercase py-5 transition-all shadow-lg transform hover:-translate-y-1 cursor-pointer rounded-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 fill-current" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 000 12a12 12 0 001.602 6.001L0 24l6.19-1.604A12 12 0 0012.056 24 12 12 0 0024 12c0-6.627-5.373-12-12.056-12zM12.056 22A10 10 0 015.353 20.32l-.382-.226-4.008 1.037 1.056-3.905-.248-.395A10 10 0 1112.056 22zm5.558-7.512c-.305-.152-1.804-.891-2.083-.993-.279-.102-.482-.152-.686.152-.203.305-.788.993-.966 1.197-.178.203-.356.228-.661.076-.305-.152-1.287-.475-2.453-1.516-.906-.81-1.517-1.809-1.696-2.114-.178-.305-.019-.469.133-.62.138-.138.305-.356.458-.534.152-.178.203-.305.305-.508.102-.203.051-.381-.025-.534-.076-.152-.686-1.652-.94-2.261-.247-.591-.497-.512-.686-.521-.178-.009-.381-.009-.584-.009-.203 0-.534.076-.813.381-.279.305-1.067 1.042-1.067 2.54 0 1.498 1.093 2.946 1.246 3.149.152.203 2.147 3.275 5.2 4.59.725.313 1.291.5 1.733.64.728.232 1.391.199 1.914.12.585-.088 1.804-.737 2.058-1.448.254-.711.254-1.32.178-1.448-.076-.127-.28-.203-.585-.356z"/></svg>
            Send Request via WhatsApp
          </button>

        </form>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('quote-modal');
    const modalContent = document.getElementById('modal-content');
    const closeBtn = document.getElementById('close-quote-modal');
    const openBtns = document.querySelectorAll('.open-quote-btn');
    const waForm = document.getElementById('whatsapp-quote-form');

    // --- Modal Open/Close Logic ---
    function openModal() {
      if (!modal || !modalContent) return;
      modal.classList.remove('hidden');
      modal.classList.add('block'); 
      
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modal.classList.add('opacity-100');
        modalContent.classList.remove('scale-95');
        modalContent.classList.add('scale-100');
        document.body.style.overflow = 'hidden'; 
      }, 10);
    }

    function closeModal() {
      if (!modal || !modalContent) return;
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      modalContent.classList.remove('scale-100');
      modalContent.classList.add('scale-95');
      
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('block');
        document.body.style.overflow = ''; 
      }, 300);
    }

    openBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault(); 
        openModal();
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target.classList.contains('min-h-screen')) {
          closeModal();
        }
      });
    }

    // --- WhatsApp Submission Logic ---
    if (waForm) {
      waForm.addEventListener('submit', function(e) {
        e.preventDefault(); // Stop normal form submission

        // Collect all data
        const name = document.getElementById('wa-name').value;
        const phone = document.getElementById('wa-phone').value;
        const email = document.getElementById('wa-email').value || 'Not provided';
        const address1 = document.getElementById('wa-address1').value;
        const city = document.getElementById('wa-city').value;
        const postcode = document.getElementById('wa-postcode').value;
        const service = document.getElementById('wa-service').value;
        const timescale = document.getElementById('wa-timescale').value;
        const description = document.getElementById('wa-description').value;

        // Format the message with asterisks for WhatsApp bolding
        const message = `*New Quote Request (CSM Man & Van)*\n\n` +
                        `*Customer:* ${name}\n` +
                        `*Phone:* ${phone}\n` +
                        `*Email:* ${email}\n\n` +
                        `*Pickup Address:* ${address1}, ${city}, ${postcode}\n\n` +
                        `*Service Required:* ${service}\n` +
                        `*Timescale:* ${timescale}\n\n` +
                        `*Job Details:* ${description}`;

        // Encode for URL
        const encodedMessage = encodeURIComponent(message);
        
        // Conor's WhatsApp Number
        const whatsappNumber = "447572289851"; 
        const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;

        // Open WhatsApp in a new tab
        window.open(whatsappUrl, '_blank');

        // Reset the form and close the modal
        waForm.reset();
        closeModal();
      });
    }
  });
</script>