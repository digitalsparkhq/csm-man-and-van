---
const reviews = [
  {
    name: "Nicholas Clarke",
    location: "Waste Removal",
    text: "Highly recommended, turned up on time and quickly removed all the items and waste as needed. Would definitely use them again",
    rating: 5
  },
  {
    name: "Liam Leech",
    location: "Bed Delivery & Disposal",
    text: "Would highly recommend! They delivered a new bed with a days notice and took an old mattress away with even shorter notice, reliable and professional and great lads, will use again 100%",
    rating: 5
  },
  {
    name: "Lucy Clowes",
    location: "Man & Van Service",
    text: "Absolute top bloke! From first contact through to completion of the job , quick replies constant contact and very professional , fair and reasonable price , very happy thank you so much. Will definitely use him again.",
    rating: 5
  }
];
---

<section id="reviews" class="py-24 px-6 bg-white border-t border-gray-200 relative z-10">
  <div class="max-w-7xl mx-auto">
    
    <div class="mb-16 md:flex md:justify-between md:items-end">
      <div class="max-w-2xl text-left">
        
        <div class="relative inline-block mb-4">
          <span class="text-mammoth-green font-light tracking-widest uppercase text-2xl md:text-3xl block relative z-10 pb-2">
            What People Say
          </span>
          <span class="absolute bottom-0 left-0 w-full h-[3px] bg-mammoth-green animate-slide-right origin-left"></span>
        </div>

        <h2 class="text-4xl md:text-5xl font-black uppercase text-gray-900 leading-tight mt-2">
          Customer <br/> <span class="text-gray-500">Reviews</span>
        </h2>
      </div>
      <p class="text-gray-600 mt-6 md:mt-0 max-w-sm md:text-right font-medium">
        Don't just take our word for it. See why our customers trust CSM Man & Van Services for a versatile, careful, and reliable service.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {reviews.map(review => (
        <div class="bg-[#808080] border-2 border-transparent p-8 rounded-sm shadow-xl hover:shadow-2xl hover:border-mammoth-green hover:-translate-y-2 transition-all duration-300 relative overflow-hidden group flex flex-col h-full">
          
          <svg xmlns="http://www.w3.org/2000/svg" class="absolute top-6 right-6 h-16 w-16 text-charcoal/20 group-hover:scale-110 transition-transform duration-500" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>

          <div class="flex gap-1 mb-6 relative z-10">
            {[...Array(review.rating)].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-mammoth-green" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>

          <p class="text-gray-100 leading-relaxed mb-8 relative z-10 italic flex-grow">
            "{review.text}"
          </p>

          <div class="mt-auto border-t border-white/20 pt-4 relative z-10">
            <h4 class="text-white font-bold uppercase tracking-wide">{review.name}</h4>
            <span class="text-gray-900 text-sm font-black uppercase">{review.location}</span>
          </div>

        </div>
      ))}
    </div>

    <div class="text-center">
      <button class="open-quote-btn px-8 py-5 bg-charcoal hover:bg-mammoth-green text-white hover:text-white font-black text-lg uppercase transition-all shadow-xl transform hover:-translate-y-1 inline-block border-b-4 border-black hover:border-blue-700 cursor-pointer rounded-sm">
        Get Your Free Quote
      </button>
    </div>

  </div>
</section>

<style>
  @keyframes slideRight {
    0% { transform: scaleX(0); }
    50% { transform: scaleX(1); }
    100% { transform: scaleX(0); }
  }
  .animate-slide-right {
    animation: slideRight 3.5s ease-in-out infinite;
  }
</style>