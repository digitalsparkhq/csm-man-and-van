---
// 1. Projects with BOTH Before & After photos
const beforeAfterProjects = [
  {
    title: "Garden Maintenance & Overhaul",
    beforeImg: "/images/garden-before.jpeg",
    afterImg: "/images/garden-after.jpeg",
  },
  {
    title: "House Move & Clearance",
    beforeImg: "/images/house-moving-before.jpg",
    afterImg: "/images/house-moving-after.jpeg",
  }
];

// 2. Projects with SINGLE photos
const singleProjects = [
  {
    title: "House Cleaning",
    desc: "Deep cleans and decluttering for a fresh, welcoming home environment.",
    img: "/images/house-cleaning.jpeg"
  },
  {
    title: "Waste Management",
    desc: "Heavy rubble and tenant property clearances.",
    img: "/images/waste-clearance.jpg"
  }
];
---

<section class="py-24 bg-white overflow-hidden border-t border-gray-200" id="gallery">
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    
    <div class="text-left mb-16 reveal-on-scroll max-w-2xl">
      <div class="relative inline-block mb-4">
        <span class="text-mammoth-green font-light tracking-widest uppercase text-2xl md:text-3xl block relative z-10 pb-2">
          Our Recent Work
        </span>
        <span class="absolute bottom-0 left-0 w-full h-[3px] bg-mammoth-green animate-slide-right origin-left"></span>
      </div>
      <h2 class="text-4xl md:text-5xl font-black uppercase text-gray-900 leading-tight mt-2">
        See The <span class="text-gray-500">Difference</span>
      </h2>
      <p class="text-lg text-gray-600 mt-6 font-medium">
        Take a look at some of our latest property transformations, clearances, and moves. 
      </p>
    </div>

    <h3 class="text-2xl font-black uppercase text-charcoal mb-8 border-l-4 border-mammoth-green pl-4">Transformations</h3>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mb-20">
      {beforeAfterProjects.map((project) => (
        <div class="group flex flex-col items-center reveal-on-scroll bg-charcoal p-4 rounded-sm shadow-xl border-t-4 border-mammoth-green">
          
          <div class="gallery-trigger relative w-full aspect-[4/3] flex rounded-sm overflow-hidden shadow-sm border border-gray-700 hover:shadow-2xl transition-all duration-300 cursor-pointer"
               data-title={project.title}
               data-before={project.beforeImg}
               data-after={project.afterImg}>
            
            <div class="absolute inset-0 bg-charcoal/0 group-hover:bg-charcoal/40 z-20 transition-colors duration-300 flex items-center justify-center pointer-events-none">
                <svg class="w-16 h-16 text-mammoth-green opacity-0 group-hover:opacity-100 transition-opacity duration-300 drop-shadow-lg transform scale-50 group-hover:scale-100" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" /></svg>
            </div>

            <div class="w-1/2 relative h-full overflow-hidden">
              <img src={project.beforeImg} alt="Before" class="w-full h-full object-cover grayscale-[20%] brightness-75 transition-transform duration-700 group-hover:scale-105" />
              <div class="absolute top-3 left-3 bg-black/80 backdrop-blur-sm text-white text-xs font-black px-3 py-1 rounded-sm uppercase tracking-wider">Before</div>
            </div>

            <div class="absolute inset-y-0 left-1/2 w-1 bg-mammoth-green z-10 transform -translate-x-1/2 shadow-[0_0_10px_rgba(61,245,102,0.5)]"></div>

            <div class="w-1/2 relative h-full overflow-hidden">
              <img src={project.afterImg} alt="After" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
              <div class="absolute top-3 right-3 bg-mammoth-green text-charcoal text-xs font-black px-3 py-1 rounded-sm uppercase tracking-wider shadow-sm">After</div>
            </div>

          </div>

          <h4 class="text-xl font-black text-white uppercase mt-6 text-center">{project.title}</h4>
        </div>
      ))}
    </div>

    <h3 class="text-2xl font-black uppercase text-charcoal mb-8 border-l-4 border-mammoth-green pl-4">Clearances & Transport</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
      {singleProjects.map((project) => (
        <div class="group relative aspect-video overflow-hidden bg-gray-100 rounded-sm border-2 border-transparent hover:border-mammoth-green shadow-md transition-all duration-300 hover:-translate-y-1">
          <img src={project.img} alt={project.title} class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent z-10"></div>
          <div class="absolute inset-0 p-6 flex flex-col justify-end z-20">
            <h4 class="text-2xl font-black text-white uppercase drop-shadow-md mb-1">{project.title}</h4>
            <p class="text-mammoth-green font-bold text-sm tracking-wide">{project.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-charcoal rounded-sm shadow-2xl border-t-8 border-mammoth-green p-8 md:p-12 reveal-on-scroll">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        
        <div class="text-left">
          <h3 class="text-3xl md:text-4xl font-black uppercase text-white mb-6">Attic Insulation <span class="text-mammoth-green block mt-2">Installation</span></h3>
          
          <div class="space-y-4 text-gray-300 text-lg leading-relaxed mb-8">
            <p>Watch our team in action as we tackle a severe loft insulation issue for a completely satisfied customer.</p>
            <p>Wet, damaged insulation can lead to dampness, mold, and massive heat loss. In this video, you can see our efficient process of completely uninstalling and safely disposing of the ruined material.</p>
            <p>Once cleared, we prep the space and lay down a fresh, high-quality dry installation to instantly improve the property's energy efficiency.</p>
          </div>

          <ul class="space-y-4">
            <li class="flex items-center gap-3 text-white font-bold tracking-wide">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-mammoth-green" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              Complete Wet Insulation Removal
            </li>
            <li class="flex items-center gap-3 text-white font-bold tracking-wide">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-mammoth-green" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              Safe & Licensed Disposal
            </li>
            <li class="flex items-center gap-3 text-white font-bold tracking-wide">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-mammoth-green" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              Fresh Dry Reinstallation
            </li>
          </ul>
        </div>
        
        <div class="flex justify-center md:justify-end">
          <div class="bg-black rounded-sm overflow-hidden border-4 border-gray-700 shadow-2xl inline-block">
            <iframe 
              src="https://www.facebook.com/plugins/video.php?height=476&href=https%3A%2F%2Fwww.facebook.com%2Freel%2F891550843751738%2F&show_text=false&width=267&t=0" 
              width="267" 
              height="476" 
              style="border:none;overflow:hidden" 
              scrolling="no" 
              allowfullscreen="true" 
              allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share">
            </iframe>
          </div>
        </div>

      </div>
    </div>

    <div class="mt-16 text-center reveal-on-scroll">
      <button class="open-quote-btn px-8 py-5 bg-charcoal hover:bg-mammoth-green text-white hover:text-charcoal font-black text-lg uppercase transition-all shadow-xl transform hover:-translate-y-1 inline-block border-b-4 border-black hover:border-green-600 cursor-pointer rounded-sm">
        Start Your Transformation
      </button>
    </div>

  </div>
</section>

<div id="lightbox" class="fixed inset-0 z-[100] hidden flex-col items-center justify-center p-4 sm:p-8 opacity-0 transition-opacity duration-300" aria-modal="true" role="dialog">
  
  <div id="lightbox-backdrop" class="absolute inset-0 bg-charcoal/95 backdrop-blur-md cursor-pointer transition-opacity"></div>
  
  <button type="button" id="lightbox-close" class="absolute top-6 right-6 sm:top-8 sm:right-8 text-white/70 hover:text-mammoth-green focus:outline-none z-50 cursor-pointer bg-black/50 hover:bg-black p-3 rounded-full transition-all">
    <span class="sr-only">Close image</span>
    <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
  </button>

  <div class="relative z-10 w-full max-w-5xl flex flex-col items-center transform scale-95 transition-transform duration-300" id="lightbox-content">
    <h3 id="lightbox-title" class="text-2xl md:text-4xl font-black uppercase text-white mb-8 text-center drop-shadow-md"></h3>
    
    <div class="relative w-full aspect-[4/3] md:aspect-[16/9] flex rounded-sm overflow-hidden shadow-2xl border-4 border-charcoal">
      
      <div class="w-1/2 relative h-full bg-black">
        <img id="lightbox-before" src="" alt="Full Before View" class="w-full h-full object-contain md:object-cover grayscale-[15%] brightness-[0.85]" />
        <div class="absolute top-4 left-4 md:top-6 md:left-6 bg-black/80 backdrop-blur-sm text-white text-sm md:text-lg font-black px-4 py-2 rounded-sm uppercase tracking-wider">Before</div>
      </div>
      
      <div class="absolute inset-y-0 left-1/2 w-1.5 md:w-2 bg-mammoth-green z-10 transform -translate-x-1/2 shadow-[0_0_20px_rgba(61,245,102,0.6)]"></div>
      
      <div class="w-1/2 relative h-full bg-black">
        <img id="lightbox-after" src="" alt="Full After View" class="w-full h-full object-contain md:object-cover" />
        <div class="absolute top-4 right-4 md:top-6 md:right-6 bg-mammoth-green text-charcoal text-sm md:text-lg font-black px-4 py-2 rounded-sm uppercase tracking-wider shadow-lg">After</div>
      </div>

    </div>
  </div>
</div>

<style>
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(40px) scale(0.95);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .is-revealed {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .img-loaded {
    transform: scale(1) !important;
  }
  @keyframes slideRight {
    0% { transform: scaleX(0); }
    50% { transform: scaleX(1); }
    100% { transform: scaleX(0); }
  }
  .animate-slide-right {
    animation: slideRight 3.5s infinite;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    
    // Scroll Reveal Animation
    const revealOptions = { root: null, rootMargin: '0px', threshold: 0.1 };
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        }
      });
    }, revealOptions);

    document.querySelectorAll('.reveal-on-scroll').forEach(el => revealObserver.observe(el));

    // Lightbox Logic
    const triggers = document.querySelectorAll('.gallery-trigger');
    const lightbox = document.getElementById('lightbox');
    const closeBtn = document.getElementById('lightbox-close');
    const backdrop = document.getElementById('lightbox-backdrop');
    const lbTitle = document.getElementById('lightbox-title');
    const lbBefore = document.getElementById('lightbox-before');
    const lbAfter = document.getElementById('lightbox-after');
    const lbContent = document.getElementById('lightbox-content');

    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        if(lbTitle && lbBefore && lbAfter && lightbox && lbContent) {
            lbTitle.textContent = trigger.getAttribute('data-title');
            lbBefore.setAttribute('src', trigger.getAttribute('data-before') || '');
            lbAfter.setAttribute('src', trigger.getAttribute('data-after') || '');
            
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
            document.body.style.overflow = 'hidden';
            
            setTimeout(() => {
              lightbox.classList.remove('opacity-0');
              lbContent.classList.add('img-loaded');
            }, 50);
        }
      });
    });

    const closeLightbox = () => {
      if(lightbox && lbContent) {
          lightbox.classList.add('opacity-0');
          lbContent.classList.remove('img-loaded');
          setTimeout(() => {
            lightbox.classList.add('hidden');
            lightbox.classList.remove('flex');
            document.body.style.overflow = 'auto';
            if (lbBefore) lbBefore.setAttribute('src', '');
            if (lbAfter) lbAfter.setAttribute('src', '');
          }, 300); 
      }
    };

    if(closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if(backdrop) backdrop.addEventListener('click', closeLightbox);
    
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('hidden')) {
        closeLightbox();
      }
    });
  });
</script>