              </div>
              <div class="text-center md:text-left">
                <span class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">Conor Mahon</span>
                <span class="font-black text-xl text-white group-hover:text-mammoth-green transition-colors">07572 289851</span>
              </div>
            </a>
          </li>

          <li>
            <a href="mailto:csm.mavservices@gmail.com" class="flex flex-col md:flex-row items-center justify-center md:justify-start gap-4 hover:text-mammoth-green transition-colors group">
