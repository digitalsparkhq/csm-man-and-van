                <span class="text-sm text-gray-300 font-medium leading-relaxed">
                  Selby, North Yorkshire<br/>YO8 8DZ, United Kingdom
                </span>
              </div>
            </div>
          </li>
        </ul>

        <div class="flex items-center justify-center md:justify-start gap-4 w-full mt-2">
          <a href="https://www.facebook.com/people/CSM-Man-Van-Services/61554871155041/" target="_blank" rel="noopener noreferrer" class="bg-gray-800 p-3 rounded-sm hover:bg-mammoth-green hover:text-charcoal transition-all transform hover:-translate-y-1" aria-label="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
