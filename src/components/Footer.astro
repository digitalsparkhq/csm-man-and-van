          <span class="w-2 h-2 bg-mammoth-orange block hidden md:block"></span> Contact Us
        </h4>
        <ul class="space-y-6 mb-8 w-full">
          
          <li>
            <a href="tel:07572289851" class="flex flex-col md:flex-row items-center justify-center md:justify-start gap-4 hover:text-mammoth-green transition-colors group">
              <div class="bg-gray-800 p-3 rounded-sm group-hover:bg-mammoth-green group-hover:text-charcoal transition-colors">
