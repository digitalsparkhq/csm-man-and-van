    <div class="flex flex-col md:flex-row justify-between items-center text-sm font-medium text-gray-500 gap-4 text-center md:text-left">
      <p>&copy; {currentYear} CSM Man & Van Services. All rights reserved.</p>
      
      <p class="tracking-wide">
        Designed by 
        <a href="https://digitalsparkhq.com/" target="_blank" rel="noopener noreferrer" class="hover:text-mammoth-green transition-colors text-gray-400 font-bold">
