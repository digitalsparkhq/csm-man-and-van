---
const currentYear = new Date().getFullYear();
---

<footer class="bg-charcoal text-gray-300 py-16 border-t-[12px] border-mammoth-green relative z-10 font-sans">
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 mb-12 border-b border-gray-700 pb-12 text-center md:text-left">
      
      <div class="flex flex-col items-center md:col-span-2 lg:col-span-1 lg:items-start md:text-center lg:text-left">
        
        <a href="/" class="inline-block mb-6 bg-white px-4 py-2 rounded-sm shadow-lg border-b-4 border-mammoth-green">
          <img src="/images/logo.png" alt="CSM Man & Van Services" class="h-16 md:h-20 w-auto" />
        </a>
        
        <p class="text-gray-400 mb-8 leading-relaxed max-w-sm mx-auto lg:mx-0">
          A family-run business based in Selby. Your number one choice for house moves, property clearances, and professional waste disposal across Yorkshire.
        </p>
        
        <div class="inline-flex items-center gap-3 bg-black/40 border border-white/10 px-4 py-2 rounded-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-mammoth-green" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span class="font-bold text-sm tracking-wide uppercase text-white">
            Waste Carrier: <span class="text-mammoth-green">Fully Licensed</span>
          </span>
        </div>
      </div>

      <div class="flex flex-col items-center md:items-start w-full">
        <h4 class="text-white font-black uppercase tracking-widest text-lg mb-6 flex items-center justify-center md:justify-start gap-2 w-full">
          <span class="w-2 h-2 bg-mammoth-orange block hidden md:block"></span> Quick Links
        </h4>
        <ul class="space-y-4 w-full">
          <li><a href="/" class="hover:text-mammoth-green transition-colors uppercase text-sm font-bold tracking-wide flex items-center justify-center md:justify-start gap-2"><span class="text-gray-600 hidden md:inline">&rarr;</span> Home</a></li>
          <li><a href="/#services" class="hover:text-mammoth-green transition-colors uppercase text-sm font-bold tracking-wide flex items-center justify-center md:justify-start gap-2"><span class="text-gray-600 hidden md:inline">&rarr;</span> Services</a></li>
          <li><a href="/#gallery" class="hover:text-mammoth-green transition-colors uppercase text-sm font-bold tracking-wide flex items-center justify-center md:justify-start gap-2"><span class="text-gray-600 hidden md:inline">&rarr;</span> Gallery</a></li>
          <li><a href="/#reviews" class="hover:text-mammoth-green transition-colors uppercase text-sm font-bold tracking-wide flex items-center justify-center md:justify-start gap-2"><span class="text-gray-600 hidden md:inline">&rarr;</span> Reviews</a></li>
          <li><a href="/#about" class="hover:text-mammoth-green transition-colors uppercase text-sm font-bold tracking-wide flex items-center justify-center md:justify-start gap-2"><span class="text-gray-600 hidden md:inline">&rarr;</span> About Us</a></li>
          <li><button class="open-quote-btn hover:text-white transition-colors uppercase text-sm font-black tracking-wide flex items-center justify-center md:justify-start gap-2 cursor-pointer text-mammoth-green w-full md:w-auto"><span class="text-gray-600 hidden md:inline">&rarr;</span> Book Now</button></li>
        </ul>
      </div>

      <div class="flex flex-col items-center md:items-start w-full">
