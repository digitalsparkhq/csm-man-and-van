---
const services = [
  { 
    title: "Garden Maintenance", 
    desc: "Military-standard garden overhauls, hedge cutting, grass trimming, and green waste clearance to transform your outdoor space.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" /></svg>`,
    isPriority: true
  },
  { 
    title: "House & Office Moves", 
    desc: "Stress-free local and long-distance removals. We safely transport your belongings to your new property, near or far.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" /></svg>`
  },
  { 
    title: "Waste Management", 
    desc: "Comprehensive commercial and domestic waste removal, including full end-of-tenancy clearances and tip runs.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>`
  },
  { 
    title: "Handyman & Repairs", 
    desc: "From fixing leaks to removing wet loft insulation and reinstalling fresh, dry insulation. No job is too small.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`
  },
  { 
    title: "Hazardous Waste", 
    desc: "Safe, compliant, and fully licensed removal of hazardous materials from your domestic or commercial property.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`
  },
  { 
    title: "Bulky Item Delivery", 
    desc: "Bought something big online? We provide reliable transport and delivery for large furniture, appliances, and motorcycles.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>`
  }
];
---

<section id="services" class="py-24 px-6 bg-white border-t-8 border-mammoth-green relative z-10">
  <div class="max-w-7xl mx-auto">
    
    <div class="mb-16 md:flex md:justify-between md:items-end">
      <div class="max-w-2xl">
        <div class="relative inline-block mb-4">
          <span class="text-mammoth-green font-light tracking-widest uppercase text-2xl md:text-3xl block relative z-10 pb-2">
            What We Do
          </span>
          <span class="absolute bottom-0 left-0 w-full h-[3px] bg-mammoth-green animate-slide-right origin-left"></span>
        </div>
        <h2 class="text-4xl md:text-5xl font-black uppercase text-gray-900 leading-tight mt-2">
          Versatile <br/> <span class="text-[#808080]">Property Services</span>
        </h2>
      </div>
      <p class="text-gray-600 mt-6 md:mt-0 max-w-sm md:text-right font-medium">
        If you are looking for a versatile, friendly, and reliable service, look no further. We really can do it all.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map(service => (
        <div class="bg-[#808080] border-2 border-transparent p-8 hover:border-mammoth-green hover:-translate-y-1 transition-all duration-300 group flex flex-col h-full relative overflow-hidden rounded-sm shadow-md hover:shadow-xl">
          
          <div class="absolute -right-8 -top-8 w-24 h-24 bg-charcoal/20 rounded-full group-hover:scale-150 transition-transform duration-500"></div>

          <div class="flex justify-between items-start mb-6 relative z-10">
            <div class="text-mammoth-green group-hover:scale-110 transition-transform duration-300 origin-left">
              <Fragment set:html={service.icon} />
            </div>
            
            {service.isPriority && (
              <span class="bg-mammoth-green text-charcoal text-xs font-black uppercase tracking-wider px-3 py-1 rounded-sm shadow-sm animate-pulse">
                Seasonal Priority
              </span>
            )}
          </div>

          <h3 class="text-2xl font-black text-white uppercase mb-4 relative z-10">{service.title}</h3>
          <p class="text-gray-100 leading-relaxed mb-8 flex-grow relative z-10">
            {service.desc}
          </p>

          <button class="open-quote-btn mt-auto inline-flex items-center gap-2 text-white font-bold uppercase tracking-wide border-b-2 border-mammoth-green pb-1 w-max hover:text-mammoth-green transition-colors relative z-10 cursor-pointer">
            Book Service
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </button>
        </div>
      ))}
    </div>

  </div>
</section>

<section class="relative py-24 px-6 overflow-hidden bg-charcoal border-t-4 border-black">
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/european-bg.jpeg" 
      alt="Nationwide and European Transport" 
      class="w-full h-full object-cover opacity-30" 
    />
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal via-charcoal/90 to-charcoal/40"></div>
  </div>

  <div class="max-w-7xl mx-auto relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    
    <div>
      <div class="inline-flex items-center gap-2 bg-mammoth-green/10 border border-mammoth-green/30 px-3 py-1 rounded-sm mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-mammoth-green" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span class="text-mammoth-green text-sm font-bold uppercase tracking-wider">Premium Transport Services</span>
      </div>
      
      <h2 class="text-4xl md:text-5xl font-black uppercase text-white leading-tight mb-6">
        Local, Nationwide & <br/> <span class="text-mammoth-green">European Coverage</span>
      </h2>
      
      <p class="text-lg text-gray-300 leading-relaxed mb-8 max-w-xl">
        No distance is too far. Whether you are moving down the street, across the UK to the Isle of Wight, or safely transporting a motorcycle to mainland Europe, One Man One Van provides secure, dedicated transport for your most valuable items.
      </p>

      <ul class="space-y-4 mb-10">
        <li class="flex items-center gap-3 text-white font-bold tracking-wide">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-mammoth-green" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Dedicated Isle of Wight Runs
        </li>
        <li class="flex items-center gap-3 text-white font-bold tracking-wide">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-mammoth-green" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Specialist Motorcycle Transportation
        </li>
        <li class="flex items-center gap-3 text-white font-bold tracking-wide">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-mammoth-green" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Cross-Border European Transport
        </li>
      </ul>

      <button class="open-quote-btn px-8 py-4 bg-mammoth-green hover:bg-white text-charcoal font-black uppercase tracking-widest text-sm transition-all shadow-xl rounded-sm cursor-pointer">
        Request Transport Quote
      </button>
    </div>

    <div class="flex justify-center lg:justify-end">
      <div class="bg-black rounded-sm overflow-hidden border-4 border-gray-700 shadow-2xl relative inline-block">
        <iframe 
          src="https://www.facebook.com/plugins/video.php?height=476&href=https%3A%2F%2Fwww.facebook.com%2Freel%2F1258816726345267%2F&show_text=false&width=267&t=0" 
          width="267" 
          height="476" 
          style="border:none;overflow:hidden" 
          scrolling="no" 
          allowfullscreen="true" 
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share">
        </iframe>
      </div>
    </div>

  </div>
</section>

<style>
  @keyframes slideRight {
    0% { transform: scaleX(0); }
    50% { transform: scaleX(1); }
    100% { transform: scaleX(0); }
  }
  .animate-slide-right {
    animation: slideRight 3.5s infinite;
  }
</style>