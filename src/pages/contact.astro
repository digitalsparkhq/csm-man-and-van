---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="relative pt-48 pb-24 px-6 min-h-[40vh] flex items-center justify-center overflow-hidden border-b-8 border-mammoth-green">
    <div class="absolute inset-0 z-0">
      <img 
        src="https://images.unsplash.com/photo-1600518464441-9154a4dea21b?auto=format&fit=crop&q=80&w=1920" 
        alt="Contact One Man One Van" 
        class="w-full h-full object-cover" 
      />
      <div class="absolute inset-0 bg-charcoal/85"></div>
    </div>
    
    <div class="relative z-10 text-center max-w-3xl mx-auto">
      <span class="text-mammoth-green font-bold tracking-widest uppercase text-sm md:text-base mb-4 block">Get In Touch</span>
      <h1 class="text-5xl md:text-7xl font-black uppercase text-white mb-6 drop-shadow-lg">
        Contact <span class="text-mammoth-green">Us</span>
      </h1>
      <p class="text-xl text-gray-300 font-medium max-w-2xl mx-auto">
        Ready to move, clear, or fix? Reach out for a free, no-obligation quote. We're here to do the heavy lifting for you.
      </p>
    </div>
  </section>

  <section class="py-24 px-6 bg-white relative z-10">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-12">
      
      <div class="lg:col-span-1 space-y-10">
        <div>
          <h2 class="text-3xl font-black uppercase text-gray-900 mb-6 border-l-4 border-mammoth-green pl-4">Direct Lines</h2>
          <p class="text-gray-600 mb-8 leading-relaxed">
            Need an urgent job done or have a specific question? Give Eric or Craig a call directly, or drop us a message on WhatsApp.
          </p>
        </div>

        <div class="space-y-6">
          <a href="tel:07398719488" class="flex items-start gap-4 group">
            <div class="bg-[#808080] p-4 rounded-sm group-hover:bg-mammoth-green group-hover:text-charcoal transition-colors text-white shadow-md">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </div>
            <div>
              <span class="block text-sm font-bold text-gray-500 uppercase tracking-wider mb-1">Call Eric</span>
              <span class="text-2xl font-black text-gray-900 group-hover:text-mammoth-green transition-colors">07398 719488</span>
            </div>
          </a>

          <a href="tel:07557768898" class="flex items-start gap-4 group">
            <div class="bg-[#808080] p-4 rounded-sm group-hover:bg-mammoth-green group-hover:text-charcoal transition-colors text-white shadow-md">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            </div>
            <div>
              <span class="block text-sm font-bold text-gray-500 uppercase tracking-wider mb-1">Call Craig</span>
              <span class="text-2xl font-black text-gray-900 group-hover:text-mammoth-green transition-colors">07557 768898</span>
            </div>
          </a>

          <a href="https://wa.me/447398719488" target="_blank" rel="noopener noreferrer" class="flex items-start gap-4 group">
            <div class="bg-[#808080] p-4 rounded-sm group-hover:bg-mammoth-green group-hover:text-charcoal transition-colors text-white shadow-md">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 000 12a12 12 0 001.602 6.001L0 24l6.19-1.604A12 12 0 0012.056 24 12 12 0 0024 12c0-6.627-5.373-12-12.056-12zM12.056 22A10 10 0 015.353 20.32l-.382-.226-4.008 1.037 1.056-3.905-.248-.395A10 10 0 1112.056 22zm5.558-7.512c-.305-.152-1.804-.891-2.083-.993-.279-.102-.482-.152-.686.152-.203.305-.788.993-.966 1.197-.178.203-.356.228-.661.076-.305-.152-1.287-.475-2.453-1.516-.906-.81-1.517-1.809-1.696-2.114-.178-.305-.019-.469.133-.62.138-.138.305-.356.458-.534.152-.178.203-.305.305-.508.102-.203.051-.381-.025-.534-.076-.152-.686-1.652-.94-2.261-.247-.591-.497-.512-.686-.521-.178-.009-.381-.009-.584-.009-.203 0-.534.076-.813.381-.279.305-1.067 1.042-1.067 2.54 0 1.498 1.093 2.946 1.246 3.149.152.203 2.147 3.275 5.2 4.59.725.313 1.291.5 1.733.64.728.232 1.391.199 1.914.12.585-.088 1.804-.737 2.058-1.448.254-.711.254-1.32.178-1.448-.076-.127-.28-.203-.585-.356z"/></svg>
            </div>
            <div>
              <span class="block text-sm font-bold text-gray-500 uppercase tracking-wider mb-1">WhatsApp</span>
              <span class="text-lg font-bold text-gray-900 group-hover:text-mammoth-green transition-colors">Message Us</span>
            </div>
          </a>

          <div class="flex items-start gap-4 pt-4 border-t border-gray-200">
            <div class="bg-[#808080] p-4 rounded-sm text-white shadow-md">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <div>
              <span class="block text-sm font-bold text-gray-500 uppercase tracking-wider mb-1">Location</span>
              <span class="text-sm font-medium text-gray-900 leading-relaxed block max-w-[250px]">
                Catterick Road, Catterick Garrison, DL9 4<br/>Catterick Camp, United Kingdom
              </span>
            </div>
          </div>

        </div>
      </div>

      <div class="lg:col-span-2">
        <div class="bg-charcoal border-t-8 border-mammoth-green w-full shadow-2xl p-8 md:p-10 rounded-sm">
          
          <h2 class="text-3xl font-black uppercase text-white mb-2">Request an <span class="text-mammoth-green">OMOV</span> Quote</h2>
          <p class="text-gray-400 mb-8 font-medium">Fill out the details below, and we'll get back to you with a competitive price.</p>

          <form name="quote-request" method="POST" data-netlify="true" enctype="multipart/form-data" class="space-y-6">
            <input type="hidden" name="form-name" value="quote-request" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Full Name *</label>
                <input type="text" name="name" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors rounded-sm" placeholder="John Doe">
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Phone Number *</label>
                <input type="tel" name="phone" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors rounded-sm" placeholder="07123 456789">
              </div>
              <div class="md:col-span-2">
                <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Email Address</label>
                <input type="email" name="email" class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors rounded-sm" placeholder="john@example.com">
              </div>
            </div>

            <hr class="border-gray-700 my-4" />

            <div class="space-y-4">
              <div>
                <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Address Line 1 *</label>
                <input type="text" name="address_1" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors rounded-sm" placeholder="House Name/Number and Street">
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Address Line 2</label>
                <input type="text" name="address_2" class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors rounded-sm" placeholder="Apartment, suite, unit, etc. (optional)">
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Town / City *</label>
                  <input type="text" name="city" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors rounded-sm" placeholder="e.g. Catterick">
                </div>
                <div>
                  <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Postcode *</label>
                  <input type="text" name="postcode" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors uppercase rounded-sm" placeholder="DL9 4">
                </div>
              </div>
            </div>

            <hr class="border-gray-700 my-4" />

            <div class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Service Required *</label>
                  <select name="service" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors appearance-none cursor-pointer rounded-sm">
                    <option value="" disabled selected>Select a service...</option>
                    <option value="House & Office Moves">House & Office Moves</option>
                    <option value="Waste Management">Waste Management</option>
                    <option value="Garden Maintenance">Garden Maintenance</option>
                    <option value="Handyman & Repairs">Handyman & Repairs</option>
                    <option value="Hazardous Waste">Hazardous Waste</option>
                    <option value="Bulky Item Delivery">Bulky Item Delivery</option>
                    <option value="Other">Other</option>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Timescale *</label>
                  <select name="timescale" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors appearance-none cursor-pointer rounded-sm">
                    <option value="" disabled selected>When do you need it done?</option>
                    <option value="ASAP">ASAP (Urgent)</option>
                    <option value="Within 3 Days">Within 3 Days</option>
                    <option value="Within 1 Week">Within 1 Week</option>
                    <option value="Flexible">Flexible</option>
                  </select>
                </div>
              </div>

              <div>
                <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Type of Work (Brief Description) *</label>
                <textarea name="description" rows="4" required class="w-full bg-black/50 border border-gray-600 focus:border-mammoth-green text-white px-4 py-3 outline-none transition-colors resize-none rounded-sm" placeholder="Please describe the job (e.g., Moving a piano, full garden clearance, wet insulation removal)..."></textarea>
              </div>
            </div>

            <div class="bg-black/30 p-6 border border-dashed border-gray-600 rounded-sm">
              <label class="block text-sm font-bold text-gray-300 uppercase mb-2">Upload Photos (Optional)</label>
              <p class="text-xs text-gray-400 mb-4">A picture paints a thousand words and helps us give an accurate quote. <br/> <strong class="text-mammoth-green">Max file size: 5MB per image. Max 3 images.</strong></p>
              
              <input type="file" name="photos" id="page-photo-upload" accept="image/png, image/jpeg, image/jpg, image/webp" multiple class="block w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:border-0 file:text-sm file:font-bold file:uppercase file:bg-mammoth-green file:text-charcoal hover:file:bg-green-400 cursor-pointer transition-colors rounded-sm" />
              <p id="page-file-error" class="text-red-500 text-xs font-bold mt-2 hidden">One or more files exceed the 5MB limit. Please choose smaller images.</p>
            </div>

            <button type="submit" class="w-full bg-mammoth-green hover:bg-green-400 text-charcoal font-black text-xl uppercase py-5 transition-all shadow-lg transform hover:-translate-y-1 cursor-pointer rounded-sm">
              Send Booking Request
            </button>

          </form>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // File Validation Logic specific to this embedded form
    const fileInput = document.getElementById('page-photo-upload');
    const fileError = document.getElementById('page-file-error');
    const maxSizeInBytes = 5 * 1024 * 1024; // 5MB

    if (fileInput && fileError) {
      fileInput.addEventListener('change', function() {
        let isValid = true;
        
        if (this.files.length > 3) {
           alert("You can only upload a maximum of 3 images.");
           this.value = ''; 
           return;
        }

        for (let i = 0; i < this.files.length; i++) {
          if (this.files[i].size > maxSizeInBytes) {
            isValid = false;
            break;
          }
        }

        if (!isValid) {
          fileError.classList.remove('hidden');
          this.value = ''; 
        } else {
          fileError.classList.add('hidden');
        }
      });
    }
  });
</script>